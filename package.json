{
  "name": "ifix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "src/shared",
    "src/api",
    "src/workers",
    "src/web"
  ],
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "pretest": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "./scripts/local-db/reset.sh",
    "adr:check": "node scripts/sync-adrs.mjs --check",
    "openapi": "tsc --build && node src/api/dist/openapi-emit.js",
    "openapi:check": "tsc --build && node src/api/dist/openapi-emit.js --check",
    "verify": "npm run lint && npm run format && npm run typecheck && npm run adr:check && npm run openapi:check && npm run tokens:check && npm run design:literals && npm run test",
    "tokens": "node design-system/build.mjs",
    "tokens:check": "node design-system/build.mjs --check",
    "design:literals": "node scripts/check-design-literals.mjs",
    "helm:lint": "helm lint charts/api && helm lint charts/workers",
    "helm:security": "node scripts/check-helm-security.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^9.1.20",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
