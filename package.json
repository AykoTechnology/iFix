{
  "name": "ifix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "src/shared",
    "src/api",
    "src/workers"
  ],
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "./scripts/local-db/reset.sh",
    "adr:check": "node scripts/sync-adrs.mjs --check",
    "openapi": "tsc --build && node src/api/dist/openapi-emit.js",
    "openapi:check": "tsc --build && node src/api/dist/openapi-emit.js --check",
    "verify": "npm run lint && npm run typecheck && npm run adr:check && npm run openapi:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
