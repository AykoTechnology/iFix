{
  "$description": "iFix Design Tokens — fonte única de verdade de UI (ADR-011). Formato DTCG (Design Tokens Community Group), consumido pelo Style Dictionary v4 para gerar tailwind.config.ts e variáveis CSS. Transcrito do handoff do Claude Design (iFix Design System.dc.html). NÃO editar valores estéticos fora deste arquivo.",
  "$extensions": {
    "com.ifix.meta": {
      "version": "1.2.0",
      "source": "Claude Design handoff — iFix Design System.dc.html",
      "adr": "ADR-011",
      "docs": "docs/design-system/"
    },
    "com.ifix.validation": {
      "wcagLevel": "2.2 AA",
      "contrastNormalText": 4.5,
      "contrastLargeTextAndControls": 3,
      "themesToValidate": ["dark", "light"],
      "note": "O validador de contraste roda sobre AMBOS os temas na esteira de CI (Épico 11.4). Falha bloqueia o merge."
    },
    "com.ifix.fonts": {
      "license": "SIL Open Font License 1.1",
      "hosting": "self-hosted",
      "externalCdn": false,
      "format": "woff2",
      "subsets": ["latin", "latin-ext"],
      "note": "ADR-020. Proibido consumir fontes de CDN de terceiros em runtime (incl. fonts.googleapis.com): quebra implantação on-premises/air-gapped e transmite o IP do usuário a terceiro a cada carregamento."
    }
  },
