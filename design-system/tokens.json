{
  "$description": "iFix Design Tokens — fonte única de verdade de UI (ADR-011). Formato DTCG (Design Tokens Community Group), consumido pelo Style Dictionary v4 para gerar tailwind.config.ts e variáveis CSS. Transcrito do handoff do Claude Design (iFix Design System.dc.html). NÃO editar valores estéticos fora deste arquivo.",
  "$extensions": {
    "com.ifix.meta": {
      "version": "1.1.0",
      "source": "Claude Design handoff — iFix Design System.dc.html",
      "adr": "ADR-011",
      "docs": "docs/design-system/"
    },
    "com.ifix.validation": {
      "wcagLevel": "2.2 AA",
      "contrastNormalText": 4.5,
      "contrastLargeTextAndControls": 3,
      "themesToValidate": ["dark", "light"],
      "note": "O validador de contraste roda sobre AMBOS os temas na esteira de CI (Épico 11.4). Falha bloqueia o merge."
    }
  },

  "color": {
    "brand": {
      "$description": "Paleta de marca. O roxo carrega ação e seleção; o gradiente é reservado para identidade e um único destaque por tela.",
      "black": { "$type": "color", "$value": "#131313" },
      "purple": { "$type": "color", "$value": "#723CEB" },
      "purple-hover": { "$type": "color", "$value": "#8457F0" },
      "deep-purple": { "$type": "color", "$value": "#4C11CE" },
      "orange": { "$type": "color", "$value": "#FF902F" },
      "yellow": { "$type": "color", "$value": "#FFEF63" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },

    "priority": {
      "$description": "Sistema de prioridade e SLA. Estas cores NUNCA são usadas decorativamente. Toda aplicação exige rótulo textual acompanhante (Regra de Ouro 9).",
      "p1-critica": { "$type": "color", "$value": "#FF4D4D" },
      "p2-alta": { "$type": "color", "$value": "#FF902F" },
      "p3-media": { "$type": "color", "$value": "#FFEF63" },
      "p4-baixa": { "$type": "color", "$value": "#3DD68C" }
    },

    "domain": {
      "$description": "Acento por espaço de serviço ESM (ADR-012). Usado apenas em etiquetas e no seletor de espaço — nunca substitui o rótulo textual do domínio.",
      "ti": {
        "solid": { "$type": "color", "$value": "#723CEB" },
        "text": { "$type": "color", "$value": "#C4B5FD" },
        "tint": { "$type": "color", "$value": "rgba(114, 60, 235, 0.14)" }
      },
      "rh": {
        "solid": { "$type": "color", "$value": "#FF902F" },
        "text": { "$type": "color", "$value": "#FFAB61" },
        "tint": { "$type": "color", "$value": "rgba(255, 144, 47, 0.14)" }
      },
      "financas": {
        "solid": { "$type": "color", "$value": "#3DD68C" },
        "text": { "$type": "color", "$value": "#7FE6B4" },
        "tint": { "$type": "color", "$value": "rgba(61, 214, 140, 0.14)" }
      },
      "instalacoes": {
        "solid": { "$type": "color", "$value": "#5DA0FF" },
        "text": { "$type": "color", "$value": "#9FC7FF" },
        "tint": { "$type": "color", "$value": "rgba(93, 160, 255, 0.14)" }
      }
    },

    "status": {
      "$description": "Estados do chamado. Texto claro sobre fundo translúcido — nunca cor pura como fundo.",
      "novo": {
        "text": { "$type": "color", "$value": "#9FC7FF" },
        "dot": { "$type": "color", "$value": "#5DA0FF" },
        "tint": { "$type": "color", "$value": "rgba(93, 160, 255, 0.12)" }
      },
      "em-atendimento": {
        "text": { "$type": "color", "$value": "#C4B5FD" },
        "dot": { "$type": "color", "$value": "#723CEB" },
        "tint": { "$type": "color", "$value": "rgba(114, 60, 235, 0.14)" }
      },
      "aguardando-solicitante": {
        "text": { "$type": "color", "$value": "#FFEF63" },
        "dot": { "$type": "color", "$value": "#FFEF63" },
        "tint": { "$type": "color", "$value": "rgba(255, 239, 99, 0.12)" }
      },
      "resolvido": {
        "text": { "$type": "color", "$value": "#3DD68C" },
        "dot": { "$type": "color", "$value": "#3DD68C" },
        "tint": { "$type": "color", "$value": "rgba(61, 214, 140, 0.12)" }
      },
      "sla-violado": {
        "text": { "$type": "color", "$value": "#FF6B6B" },
        "dot": { "$type": "color", "$value": "#FF4D4D" },
        "tint": { "$type": "color", "$value": "rgba(255, 77, 77, 0.12)" }
      },
      "fechado": {
        "text": { "$type": "color", "$value": "#A8A8AE" },
        "dot": { "$type": "color", "$value": "#8E8E96" },
        "tint": { "$type": "color", "$value": "#1A1A1C" }
      }
    },

    "theme": {
      "$description": "Superfícies por tema. Nenhum componente decide qual tema está ativo — sempre consome a variável resolvida (ADR-011).",
      "dark": {
        "canvas": { "$type": "color", "$value": "#0A0A0B" },
        "surface": { "$type": "color", "$value": "#131313" },
        "surface-alt": { "$type": "color", "$value": "#0E0E0F" },
        "raised": { "$type": "color", "$value": "#1A1A1C" },
        "selected": { "$type": "color", "$value": "#1F1526" },
        "border": { "$type": "color", "$value": "#232326" },
        "border-strong": { "$type": "color", "$value": "#2C2C31" },
        "border-interactive": { "$type": "color", "$value": "#3A3A41" },
        "text-primary": { "$type": "color", "$value": "#FFFFFF" },
        "text-secondary": { "$type": "color", "$value": "#A8A8AE" },
        "text-tertiary": { "$type": "color", "$value": "#8E8E96" },
        "text-muted": { "$type": "color", "$value": "#6E6E76" },
        "link": { "$type": "color", "$value": "#A78BFA" },
        "link-hover": { "$type": "color", "$value": "#C4B5FD" }
      },
      "light": {
        "canvas": { "$type": "color", "$value": "#F5F5F7" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "surface-alt": { "$type": "color", "$value": "#FFFFFF" },
        "raised": { "$type": "color", "$value": "#EDEDF0" },
        "selected": { "$type": "color", "$value": "#F0EAFB" },
        "border": { "$type": "color", "$value": "#E6E6E9" },
        "border-strong": { "$type": "color", "$value": "#D6D6DB" },
        "border-interactive": { "$type": "color", "$value": "#C2C2CA" },
        "text-primary": { "$type": "color", "$value": "#131313" },
        "text-secondary": { "$type": "color", "$value": "#6E6E76" },
        "text-tertiary": { "$type": "color", "$value": "#6E6E76" },
        "text-muted": { "$type": "color", "$value": "#8E8E96" },
        "accent": { "$type": "color", "$value": "#5B11CE" },
        "link": { "$type": "color", "$value": "#5B11CE" },
        "link-hover": { "$type": "color", "$value": "#4C11CE" }
      }
    },

    "focus-ring": {
      "$type": "color",
      "$value": "#C4B5FD",
      "$description": "Anel de foco. Nunca suprimido (ADR-005)."
    }
  },

  "gradient": {
    "brand": {
      "$type": "gradient",
      "$description": "Gradiente de marca. Permitido em: marca/login, item de navegação ativo, estado vazio ilustrado, assistente cognitivo e UM destaque por tela. Proibido em: fundo de fila, texto corrido, alertas de incidente massivo, botões destrutivos e superfícies de leitura prolongada.",
      "$value": [
        { "color": "#FF902F", "position": 0 },
        { "color": "#C05FA0", "position": 0.4 },
        { "color": "#723CEB", "position": 0.7 },
        { "color": "#4C11CE", "position": 1 }
      ],
      "$extensions": {
        "com.ifix.css": "linear-gradient(135deg, #FF902F 0%, #C05FA0 40%, #723CEB 70%, #4C11CE 100%)",
        "com.ifix.cssCompact": "linear-gradient(135deg, #FF902F, #723CEB, #4C11CE)"
      }
    }
  },

  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Gilroy", "Outfit", "system-ui", "sans-serif"],
        "$description": "Títulos e números. RISCO R1 EM ABERTO (spec § 12.1): Gilroy é comercial e NÃO é carregada por nenhum @font-face — só renderiza em máquina que já a tenha instalada. Na prática, o que renderiza hoje é Outfit (SIL OFL). Não tratar esta pilha como definitiva até o R1 ser encerrado."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["Lufga", "Outfit", "system-ui", "sans-serif"],
        "$description": "Interface e corpo de texto. RISCO R1 EM ABERTO (spec § 12.1): Lufga é comercial e NÃO é carregada por nenhum @font-face — o que renderiza hoje é Outfit (SIL OFL). A família de corpo precisa sustentar 13-15px sob WCAG 2.2 AA; ver critérios de avaliação na § 12.1."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
        "$description": "Números de chamado (INC-48192), IDs de CI (CI-SRV-0231), timestamps ISO 8601 e schemas JSON visíveis."
      }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "48px" },
      "h1": { "$type": "dimension", "$value": "32px" },
      "h2": { "$type": "dimension", "$value": "24px" },
      "h3": { "$type": "dimension", "$value": "18px" },
      "body": { "$type": "dimension", "$value": "15px" },
      "caption": { "$type": "dimension", "$value": "13px" },
      "mono": { "$type": "dimension", "$value": "13px" }
    },
    "line-height": {
      "display": { "$type": "number", "$value": 1.1 },
      "h1": { "$type": "number", "$value": 1.2 },
      "h2": { "$type": "number", "$value": 1.3 },
      "h3": { "$type": "number", "$value": 1.4 },
      "body": { "$type": "number", "$value": 1.6 },
      "caption": { "$type": "number", "$value": 1.5 }
    }
  },

  "space": {
    "$description": "Escala de 4px. O comentário indica o uso canônico de cada degrau.",
    "1": { "$type": "dimension", "$value": "4px", "$description": "ícone ↔ rótulo" },
    "2": { "$type": "dimension", "$value": "8px", "$description": "dentro de controles" },
    "3": { "$type": "dimension", "$value": "12px", "$description": "linhas da fila" },
    "4": { "$type": "dimension", "$value": "16px", "$description": "campos de formulário" },
    "6": { "$type": "dimension", "$value": "24px", "$description": "padding de card" },
    "8": { "$type": "dimension", "$value": "32px", "$description": "entre blocos" },
    "12": { "$type": "dimension", "$value": "48px", "$description": "entre seções" }
  },

  "radius": {
    "chip": { "$type": "dimension", "$value": "8px" },
    "input": { "$type": "dimension", "$value": "12px" },
    "card": { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },

  "shadow": {
    "$description": "Borda para estrutura; sombra APENAS para camadas flutuantes (dropdown, popover, modal).",
    "floating": {
      "$type": "shadow",
      "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgba(0, 0, 0, 0.5)" }
    },
    "modal": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0px", "offsetY": "20px", "blur": "48px", "spread": "0px", "color": "rgba(0, 0, 0, 0.65)" },
        { "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "color": "#2C2C31" }
      ]
    }
  },

  "layout": {
    "nav-rail-width": { "$type": "dimension", "$value": "72px" },
    "topbar-height": { "$type": "dimension", "$value": "64px" },
    "knowledge-panel-width": { "$type": "dimension", "$value": "360px" },
    "knowledge-panel-breakpoint": {
      "$type": "dimension",
      "$value": "1280px",
      "$description": "Acima deste ponto o painel de conhecimento é persistente; abaixo, vira gaveta sobreposta."
    },
    "content-max-width": { "$type": "dimension", "$value": "1440px" },
    "grid-gutter": { "$type": "dimension", "$value": "24px" },
    "table-row-height": { "$type": "dimension", "$value": "48px" }
  },

  "a11y": {
    "$description": "Tokens de acessibilidade derivados do ADR-005. São valores mínimos verificáveis, não sugestões.",
    "min-tap-target": { "$type": "dimension", "$value": "44px" },
    "focus-ring-width": { "$type": "dimension", "$value": "3px" },
    "focus-ring-offset": { "$type": "dimension", "$value": "2px" }
  }
}
