{
  "openapi": "3.1.0",
  "info": {
    "title": "iFix API",
    "description": "Plataforma ESM/ITSM. Contrato derivado dos schemas Zod (ADR-009).",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness — o processo deve continuar vivo?",
        "tags": [
          "health"
        ],
        "description": "Observa apenas o atraso do event loop. Não consulta o banco por decisão: uma indisponibilidade de banco não pode fazer o Kubernetes matar todos os pods.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness — o processo deve receber tráfego agora?",
        "tags": [
          "health"
        ],
        "description": "Verifica conectividade e latência do pooler. Remove do balanceador sem matar.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/startup": {
      "get": {
        "summary": "Startup — a inicialização terminou?",
        "tags": [
          "health"
        ],
        "description": "Confere que os objetos de schema exigidos existem. Falha aqui costuma significar aplicação implantada antes de a migração ter rodado.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "status",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/v1/people": {
      "get": {
        "summary": "Lista as pessoas visíveis ao chamador",
        "tags": [
          "people"
        ],
        "description": "O recorte por locatário é feito pelas políticas RLS, não por filtro aqui (ADR-003). A consulta não menciona tenant_id de propósito.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          },
                          "fullName": {
                            "type": "string"
                          },
                          "isActive": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "email",
                          "fullName",
                          "isActive"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Probes de saúde do pod (§ 6.3)"
    },
    {
      "name": "people",
      "description": "Pessoas do locatário"
    }
  ]
}
