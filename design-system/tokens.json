  "gradient": {
    "brand": {
      "$type": "gradient",
      "$description": "Gradiente de marca. Permitido em: marca/login, item de navegação ativo, estado vazio ilustrado, assistente cognitivo e UM destaque por tela. Proibido em: fundo de fila, texto corrido, alertas de incidente massivo, botões destrutivos e superfícies de leitura prolongada.",
      "$value": [
        {
          "color": "#FF902F",
          "position": 0
        },
        {
          "color": "#C05FA0",
          "position": 0.4
        },
        {
          "color": "#723CEB",
          "position": 0.7
        },
        {
          "color": "#4C11CE",
          "position": 1
        }
      ],
      "$extensions": {
        "com.ifix.css": "linear-gradient(135deg, #FF902F 0%, #C05FA0 40%, #723CEB 70%, #4C11CE 100%)",
        "com.ifix.cssCompact": "linear-gradient(135deg, #FF902F, #723CEB, #4C11CE)"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Outfit", "system-ui", "sans-serif"],
        "$description": "Títulos e números. Outfit (SIL OFL), self-hosted — ADR-020. Token semântico mantido separado de `body` para que reintroduzir uma família de display seja troca de valor, não refatoração de componente."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["Outfit", "system-ui", "sans-serif"],
        "$description": "Interface e corpo de texto. Outfit (SIL OFL), self-hosted — ADR-020. A hierarquia vem de tamanho e peso (ver font.size e font.weight), não de contraste entre famílias."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
        "$description": "Números de chamado (INC-48192), IDs de CI (CI-SRV-0231), timestamps ISO 8601 e schemas JSON visíveis. JetBrains Mono (SIL OFL), self-hosted — ADR-020."
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "bold": {
